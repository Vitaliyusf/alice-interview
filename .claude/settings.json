{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(python scripts/ai/check_context.py *)",
      "Bash(python scripts/ai/kit.py new*)",
      "Bash(python scripts/ai/kit.py list*)",
      "Bash(python scripts/ai/kit.py next*)",
      "Bash(python scripts/ai/kit.py status*)",
      "Bash(python scripts/ai/kit.py done*)",
      "Bash(python scripts/ai/kit.py index*)",
      "Bash(python scripts/ai/kit.py check*)",
      "Bash(python scripts/ai/kit.py doctor*)",
      "Edit(./docs/ai/**)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(python scripts/ai/kit.py start*)",
      "Bash(python scripts/ai/kit.py install*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\" >/dev/null 2>&1 && exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_edited.py\" || exec python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_edited.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
